# ==============================================================================
# BANDspirit V2 — Environment Variables (Beispiel)
# ==============================================================================
# WICHTIG: Diese Datei als .env kopieren und ALLE Platzhalter ersetzen!
#   cp .env.example .env
# ==============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=ChangeMeSecurePassword123!
POSTGRES_USER=bandspirit
POSTGRES_DB=bandspirit

# ── Backend (C# API) ──────────────────────────────────────────────────────────
# Connection String (wird automatisch aus POSTGRES_* zusammengesetzt)
CONNECTION_STRING=Host=postgres;Database=bandspirit;Username=bandspirit;Password=ChangeMeSecurePassword123!

# JWT Secret (mindestens 32 Zeichen!)
JWT_SECRET=ThisIsAVerySecureJwtSecretKeyWith32PlusCharacters!ChangeMe

# Admin-Passwort (beim ersten Start)
DEFAULT_ADMIN_PASSWORD=Admin123!ChangeMe

# Entra ID (Azure AD) — Optional, nur wenn SSO aktiviert werden soll
ENTRA_CLIENT_ID=Dummy
ENTRA_TENANT_ID=Dummy
ENTRA_CLIENT_SECRET=Dummy
ENTRA_ENABLED=false

# MinIO — On-Premise S3-kompatible Object Storage
MINIO_ROOT_USER=bandspirit-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_SECURE_PASSWORD
S3_BUCKET_NAME=bandspirit

# Microsoft Exchange SMTP (für E-Mail-Versand)
EXCHANGE_SMTP_HOST=smtp.office365.com
EXCHANGE_SMTP_PORT=587
EXCHANGE_SMTP_USER=noreply@ihrefirma.ch
EXCHANGE_SMTP_PASSWORD=PLACEHOLDER_CHANGE_ME
EXCHANGE_FROM_EMAIL=noreply@ihrefirma.ch
EXCHANGE_FROM_NAME=BANDspirit
EXCHANGE_ADMIN_EMAIL=admin@ihrefirma.ch
EXCHANGE_USE_SSL=true

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost
NEXTAUTH_SECRET=ThisIsASecureNextAuthSecretKeyPleaseChangeMe!

# API URLs
# NEXT_PUBLIC_API_URL: Client-seitige API-Calls (Browser → Nginx → API)
# API_BASE_URL: Server-seitige API-Calls (Next.js SSR → API direkt)
NEXT_PUBLIC_API_URL=http://localhost
API_BASE_URL=http://api:8080

# S3/MinIO
NEXT_PUBLIC_S3_BASE_URL=http://localhost:9000
