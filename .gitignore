# Secrets / lokale Umgebungskonfiguration
.env
.env.*
!.env.example

# Node
node_modules/

# .NET Build-Ausgaben
bin/
obj/

# Serilog-Ausgabe (Program.cs: logs/bandspirit-*.log)
logs/

# Windows-Metadaten (z. B. bei aus dem Browser heruntergeladenen Dateien)
*:Zone.Identifier

# Datenbank-Backups und Einmal-Migrationsskripte enthalten echte Personendaten
# (Namen, E-Mails) - dürfen nie versioniert werden.
backups/
scripts/*.sql
migration/*.sql
migration/*.sql.gz

# Umgebungsspezifische Konfiguration (z. B. Testumgebung Proxmox) - bleibt
# auf dem jeweiligen System, siehe README "Deployment".
docker-compose.override.yml
docker/nginx/nginx.*.conf

# TLS-Zertifikate und private Schlüssel
docker/nginx/ssl/*
