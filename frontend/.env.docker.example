# ====
# BANDspirit — Umgebungsvariablen (Beispiel) V1.0.2
# Datei kopieren: .env.docker.example → .env.docker
# NIEMALS .env.docker in Git einchecken!
# ====

# ── Nginx Ports ────────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=bandspirit
POSTGRES_PASSWORD=<sicheres-passwort-hier-einsetzen>
POSTGRES_DB=bandspirit
POSTGRES_PORT=5432

# ── JWT (C# Backend) ───────────────────────────────────────────────────────────
# Mindestens 32 Zeichen, zufällig generiert:
# openssl rand -hex 32
JWT_SECRET=<jwt-secret-hier-einsetzen>

# ── next-auth (Next.js Frontend) ───────────────────────────────────────────────
NEXTAUTH_URL=https://bandspirit.example.ch
NEXTAUTH_SECRET=<nextauth-secret-hier-einsetzen>

# ── Öffentliche API-URL (wird an Browser ausgeliefert) ─────────────────────────
NEXT_PUBLIC_API_URL=https://bandspirit.example.ch

# ── Microsoft Entra ID SSO (optional — leer lassen zum Deaktivieren) ───────────
AZURE_AD_ENABLED=true
AZURE_AD_CLIENT_ID=Dummy
AZURE_AD_CLIENT_SECRET=Dummy
AZURE_AD_TENANT_ID=Dummy
# Ablauf Client Secret: 10. August 2027 — danach erneuern!

# ── AWS S3 (Datei-Upload) ──────────────────────────────────────────────────────
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=<aws-access-key>
AWS_SECRET_ACCESS_KEY=<aws-secret-key>
AWS_BUCKET_NAME=<bucket-name>
AWS_FOLDER_PREFIX=bandspirit/

# ── Abacus.AI Notifications (E-Mail) ──────────────────────────────────────────
ABACUSAI_API_KEY=<abacus-api-key>
WEB_APP_ID=<web-app-id>
NOTIF_ID_PASSWORT_ZURCKSETZEN=<notif-id>
NOTIF_ID_MEETINGEINLADUNG_ICS=<notif-id>
NOTIF_ID_SUPPORT_TICKET_ERSTELLT=<notif-id>
