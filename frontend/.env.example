# ============================================================
# BANDspirit – Beispiel-Umgebungsvariablen (interne Installation, z.B. Proxmox)
# Kopieren Sie diese Datei zu .env und tragen Sie Ihre Werte ein.
# KEINE echten Geheimnisse in die Versionsverwaltung einchecken!
# ============================================================

# --- Basis ---
# Datenbank-Verbindungszeichenkette
DATABASE_URL="postgresql://benutzer:passwort@host:5432/bandspirit"

# Absolute Basis-URL der Anwendung (ohne abschliessenden Schrägstrich).
# Beispiel intern: https://bandspirit.ihre-domain.intern
NEXTAUTH_URL="https://bandspirit.ihre-domain.intern"

# Zufälliger Schlüssel (min. 32 Zeichen), z.B. via:  openssl rand -base64 32
NEXTAUTH_SECRET="bitte-einen-langen-zufallswert-einsetzen"

# ============================================================
# --- Microsoft Entra ID (Azure AD) Single Sign-On  [V.1.0.1.1] ---
# OPTIONAL: Nur setzen, wenn der Microsoft-Login aktiviert werden soll.
# Sind alle drei Werte gesetzt, erscheint auf der Login-Seite automatisch
# der Button «Mit Microsoft anmelden». Fehlt einer der Werte, bleibt der
# Microsoft-Login vollständig deaktiviert (nur E-Mail/Passwort).
#
# Redirect-URI, die in der Entra App-Registrierung (Plattform: Web)
# hinterlegt werden muss (NEXTAUTH_URL entsprechend anpassen):
#   {NEXTAUTH_URL}/api/auth/callback/azure-ad
#
# Wichtig: Es werden NUR bestehende, aktive BANDspirit-Benutzer zugelassen.
# Die Zuordnung erfolgt über die E-Mail-Adresse. Es werden keine neuen
# Konten automatisch angelegt.
# ============================================================
AZURE_AD_CLIENT_ID="Dummy"
AZURE_AD_CLIENT_SECRET="Dummy"
# Verzeichnis-(Mandanten-)ID; für Multi-Tenant/persoenliche Konten: common
AZURE_AD_TENANT_ID="Dummy"
